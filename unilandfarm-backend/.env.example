# ============================================================
# UniLandFarm Backend — Environment Variables
# JANGAN pernah commit file ini ke Git!
# Salin file ini menjadi .env dan isi nilainya.
# ============================================================

# ----- SERVER -----
PORT=5000
NODE_ENV=development

# ----- DATABASE (MySQL via Prisma) -----
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:your_password@localhost:3306/unilandfarm_db"

# ----- JWT AUTHENTICATION -----
JWT_SECRET="ganti_dengan_string_acak_sangat_panjang_dan_aman_min_64_char"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="ganti_dengan_refresh_secret_berbeda_dan_juga_panjang"
JWT_REFRESH_EXPIRES_IN="30d"

# ----- CORS -----
# URL frontend Next.js (dev)
CORS_ORIGIN="http://localhost:3000"

# ----- GOOGLE AI STUDIO (GEMINI API) -----
GEMINI_API_KEY="masukkan_gemini_api_key_dari_aistudio_google_com"
GEMINI_MODEL="gemini-1.5-flash"

# ----- GOOGLE OAUTH (opsional, jika pakai Google Auth) -----
GOOGLE_CLIENT_ID="masukkan_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="masukkan_google_oauth_client_secret"

# ----- MIDTRANS PAYMENT GATEWAY -----
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false

# ----- XENDIT PAYMENT GATEWAY (alternatif) -----
XENDIT_SECRET_KEY="xnd_development_xxxxxxxxxxxxxxxxxxxx"
XENDIT_WEBHOOK_TOKEN="masukkan_webhook_verification_token"

# ----- FILE UPLOAD -----
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# ----- APP BASE URL -----
# URL publik backend (untuk webhook payment gateway)
APP_BASE_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"
