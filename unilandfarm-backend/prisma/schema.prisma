// ============================================================
// UniLandFarm — Prisma Schema (MySQL)
// Platform: Instant Landing Page Builder & CMS berbasis AI
// Architecture: Decoupled (Express.js Backend + Next.js Frontend)
// Last Updated: 2026-10-15
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUM DEFINITIONS
// ============================================================

/// Role pengguna: UMKM Client atau Admin Uni-Inside
enum UserRole {
  CLIENT
  ADMIN
}

/// Status akun pengguna
enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

/// Provider autentikasi
enum AuthProvider {
  LOCAL
  GOOGLE
}

/// Status publikasi landing page
enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SUSPENDED
}

/// Tipe section pada landing page
enum SectionType {
  HERO
  FEATURES
  CATALOG
  TESTIMONIALS
  FAQ
  CONTACT
  GALLERY
  PRICING_TABLE
  CUSTOM
}

/// Status transaksi top-up token
enum TransactionStatus {
  PENDING
  SUCCESS
  REJECTED
  EXPIRED
  REFUNDED
}

/// Metode pembayaran
enum PaymentMethod {
  VIRTUAL_ACCOUNT
  QRIS
  MANUAL_TRANSFER
  MIDTRANS
  XENDIT
}

/// Status jadwal konten AI
enum ScheduleStatus {
  QUEUED
  PROCESSING
  APPLIED
  FAILED
  CANCELLED
}

/// Tipe notifikasi yang dikirim
enum NotificationType {
  INFO
  PROMO
  WARNING
  SYSTEM
  TRANSACTION
  AI_RESULT
}

/// Target penerima notifikasi
enum NotificationTarget {
  BROADCAST
  INDIVIDUAL
}

/// Status baca notifikasi
enum NotificationReadStatus {
  UNREAD
  READ
}

/// Tipe operasi log AI token
enum TokenLogType {
  CREDIT
  DEBIT
}

/// Tipe operasi AI yang memotong token
enum AiOperationType {
  GENERATE_PAGE
  REPHRASE_TEXT
  EXTEND_TEXT
  SHORTEN_TEXT
  CHANGE_TONE
  SCHEDULE_CONTENT
  GENERATE_SECTION
}

// ============================================================
// ENTITY 1: USERS
// Menyimpan data akun UMKM (Client) dan Admin Uni-Inside
// ============================================================

model User {
  id                  String       @id @default(cuid())
  name                String       @db.VarChar(150)
  email               String       @unique @db.VarChar(255)
  password            String?      @db.VarChar(255)
  role                UserRole     @default(CLIENT)
  status              UserStatus   @default(ACTIVE)
  authProvider        AuthProvider @default(LOCAL)
  googleId            String?      @unique @db.VarChar(255)
  avatarUrl           String?      @db.Text
  phoneNumber         String?      @db.VarChar(20)
  businessName        String?      @db.VarChar(200)
  tokenBalance        Int          @default(0)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  passwordResetToken  String?      @db.VarChar(255)
  passwordResetExpiry DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relations
  landingPages        LandingPage[]
  transactions        Transaction[]
  contentSchedules    ContentSchedule[]
  mediaFiles          MediaFile[]
  notifications       Notification[]    @relation("NotificationRecipient")
  sentNotifications   Notification[]    @relation("NotificationSender")
  aiTokenLogs         AiTokenLog[]

  @@index([email])
  @@index([role, status])
  @@map("users")
}

// ============================================================
// ENTITY 2: TEMPLATES
// Master template landing page yang dikonfigurasi Admin
// ============================================================

model Template {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(150)
  description  String?  @db.Text
  category     String   @db.VarChar(100)
  thumbnailUrl String?  @db.Text
  /// Struktur JSON default sections template (array of SectionConfig)
  sectionsJson Json
  /// Biaya token AI untuk memakai template ini (0 = gratis)
  tokenCost    Int      @default(0)
  isActive     Boolean  @default(true)
  usageCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  landingPages LandingPage[]

  @@index([category, isActive])
  @@map("templates")
}

// ============================================================
// ENTITY 3: LANDING PAGES
// Halaman landing UMKM yang dibuat via AI atau editor manual
// ============================================================

model LandingPage {
  id              String        @id @default(cuid())
  userId          String
  templateId      String?
  title           String        @db.VarChar(200)
  slug            String        @unique @db.VarChar(250)
  publishStatus   PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?       @db.VarChar(200)
  metaDescription String?       @db.VarChar(500)
  metaKeywords    String?       @db.VarChar(300)
  /// Kuesioner AI Builder: disimpan untuk regenerasi
  businessName    String?       @db.VarChar(200)
  category        String?       @db.VarChar(100)
  description     String?       @db.Text
  tone            String?       @db.VarChar(50)
  /// Sticky WhatsApp CTA
  whatsappNumber  String?       @db.VarChar(25)
  whatsappMessage String?       @db.Text
  /// Statistik kunjungan (denormalized untuk performa)
  viewCount       Int           @default(0)
  uniqueVisitors  Int           @default(0)
  tokenConsumed   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template         Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sections         Section[]
  contentSchedules ContentSchedule[]
  mediaFiles       MediaFile[]

  @@index([userId, publishStatus])
  @@index([slug])
  @@map("landing_pages")
}

// ============================================================
// ENTITY 4: SECTIONS
// Setiap blok/section dalam sebuah landing page
// ============================================================

model Section {
  id            String      @id @default(cuid())
  landingPageId String
  sectionType   SectionType
  /// Nama tampilan section (e.g. "Hero Utama", "Katalog Produk")
  label         String      @db.VarChar(150)
  /// Urutan tampil — dipakai untuk drag & drop reorder
  sortOrder     Int         @default(0)
  isVisible     Boolean     @default(true)
  /// Konten section: JSON fleksibel (teks, gambar, items, dll)
  contentJson   Json
  /// Konfigurasi style (warna, padding, background override)
  styleJson     Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, sortOrder])
  @@map("sections")
}

// ============================================================
// ENTITY 5: TRANSACTIONS
// Riwayat top-up token AI oleh Client UMKM
// ============================================================

model Transaction {
  id                   String            @id @default(cuid())
  userId               String
  /// Kode unik invoice (e.g. INV-20261015-XXXX)
  invoiceCode          String            @unique @db.VarChar(100)
  packageName          String            @db.VarChar(150)
  tokenAmount          Int
  amountPaid           Decimal           @db.Decimal(12, 2)
  paymentMethod        PaymentMethod
  status               TransactionStatus @default(PENDING)
  gatewayTransactionId String?           @db.VarChar(255)
  gatewayPaymentUrl    String?           @db.Text
  gatewayResponse      Json?
  /// Bukti transfer untuk pembayaran manual
  proofImageUrl        String?           @db.Text
  verifiedByAdminId    String?
  verifiedAt           DateTime?
  adminNote            String?           @db.Text
  expiredAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiTokenLog AiTokenLog?

  @@index([userId, status])
  @@index([invoiceCode])
  @@index([status, createdAt])
  @@map("transactions")
}

// ============================================================
// ENTITY 6: AI TOKEN LOGS
// Audit trail setiap penggunaan & penambahan token AI
// ============================================================

model AiTokenLog {
  id            String           @id @default(cuid())
  userId        String
  transactionId String?          @unique
  logType       TokenLogType
  operationType AiOperationType?
  /// Jumlah token yang ditambah (CREDIT) atau dikurangi (DEBIT)
  tokenAmount   Int
  /// Saldo setelah operasi ini (snapshot untuk audit trail)
  balanceAfter  Int
  description   String?          @db.VarChar(300)
  landingPageId String?
  createdAt     DateTime         @default(now())

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, logType])
  @@index([userId, createdAt])
  @@map("ai_token_logs")
}

// ============================================================
// ENTITY 7: CONTENT SCHEDULES
// Penjadwalan update otomatis konten AI pada landing page
// ============================================================

model ContentSchedule {
  id              String         @id @default(cuid())
  userId          String
  landingPageId   String
  scheduleName    String         @db.VarChar(200)
  /// Instruksi prompt AI (e.g. "Ubah banner menjadi promo Lebaran")
  aiPrompt        String         @db.Text
  /// Target section yang diubah (null = seluruh halaman)
  targetSectionId String?
  status          ScheduleStatus @default(QUEUED)
  scheduledAt     DateTime
  executedAt      DateTime?
  tokenConsumed   Int?
  /// Hasil perubahan konten dari AI dalam format JSON
  resultJson      Json?
  errorMessage    String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([scheduledAt, status])
  @@map("content_schedules")
}

// ============================================================
// ENTITY 8: MEDIA FILES
// Manajemen aset gambar/file yang diupload oleh Client
// ============================================================

model MediaFile {
  id            String       @id @default(cuid())
  userId        String
  landingPageId String?
  originalName  String       @db.VarChar(255)
  /// Nama file yang tersimpan di server (UUID-based)
  storedName    String       @db.VarChar(255)
  publicUrl     String       @db.Text
  mimeType      String       @db.VarChar(100)
  fileSize      Int
  width         Int?
  height        Int?
  altText       String?      @db.VarChar(300)
  createdAt     DateTime     @default(now())

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  landingPage LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([landingPageId])
  @@map("media_files")
}

// ============================================================
// ENTITY 9: NOTIFICATIONS
// Sistem notifikasi broadcast/individual Admin ke Client
// ============================================================

model Notification {
  id          String                 @id @default(cuid())
  /// Admin pengirim (null = notifikasi sistem otomatis)
  senderId    String?
  /// Penerima spesifik (null jika target = BROADCAST)
  recipientId String?
  type        NotificationType
  target      NotificationTarget
  title       String                 @db.VarChar(200)
  message     String                 @db.Text
  actionUrl   String?                @db.VarChar(500)
  readStatus  NotificationReadStatus @default(UNREAD)
  readAt      DateTime?
  createdAt   DateTime               @default(now())

  // Relations
  sender    User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient User? @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readStatus])
  @@index([target, createdAt])
  @@map("notifications")
}
